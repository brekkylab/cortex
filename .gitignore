/target
# Local microVM assets (rootfs, kernels) — large, machine-specific, not committed.
/data

# rustfmt backups
**/*.rs.bk

# MSVC debug info
*.pdb

# cargo mutants
**/mutants.out*/

# rustc ICE dumps
rustc-ice-*.txt

# Editor / OS
.DS_Store
*.swp

# Local tooling
.claude
.omc
.remember

# Generated docs write-ups (not versioned)
docs/

# Provider keys, for the tests and binaries that ask a model something. A key is a
# credential and a credential is never a file in a tree anybody clones.
.env

# Python bytecode
__pycache__/
