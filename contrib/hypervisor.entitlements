<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required to call hv_vm_create on macOS. Without it libkrun fails with
         VmSetup(VmCreate) before the guest starts. Relinking drops the
         signature, so re-sign after every build. -->
    <key>com.apple.security.hypervisor</key>
    <true/>
</dict>
</plist>
